index 0000000..0a54af3
--- /dev/null
+++ b/main-app/src/styles/focus-dashboard.css
@@ -0,0 +1,93 @@
+.dc-core-dashboard, #dc-hero-risk-root {
+  --focus-text: #1d2129;
+  --focus-secondary: #4e5969;
+  --focus-border: #e5e6eb;
+  --focus-surface: #fff;
+  --focus-page: #f2f3f5;
+  --focus-subtle: #f5f6f8;
+  color: var(--focus-text);
+  font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
+  font-variant-numeric: tabular-nums;
+  min-width: 0;
+}
+.dc-core-dashboard > * { min-width: 0; }
+.dc-core-dashboard.space-y-6 > :not([hidden]) ~ :not([hidden]) { margin-top: 16px; }
+.dc-core-toolbar, .dc-core-section-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
+.dc-core-section-toolbar > .ant-space { flex-wrap: wrap; justify-content: flex-end; gap: 8px !important; }
+.dc-core-section-toolbar > span { flex-shrink: 0; }
+.dc-core-dashboard .dc-core-metric { border-radius: 8px !important; padding: 16px !important; min-height: 144px !important; gap: 8px !important; }
+.dc-core-metric > div:first-child > span { font-size: 14px !important; color: var(--focus-secondary) !important; }
+.dc-core-metric > div:nth-child(2), .dc-core-metric > div:last-child { color: var(--focus-secondary) !important; font-size: 12px !important; }
+.dc-core-metric > div:nth-child(3) { gap: 8px; }
+.dc-core-metric > div:nth-child(3) > span { font-variant-numeric: tabular-nums; letter-spacing: -.5px; overflow-wrap: anywhere; }
+.dc-metric-icon { width: 40px; height: 40px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #1677ff; background: #eaf3ff; }
+.dc-metric-icon-pay { color: #a96909; background: #fff5dc; }
+.dc-core-dashboard .text-gray-400 { color: var(--focus-secondary); }
+.dc-core-dashboard .ant-table-wrapper { max-width: 100%; overflow-x: auto; }
+.dc-core-dashboard .ant-table { min-width: 1160px; font-variant-numeric: tabular-nums; }
+.dc-core-dashboard .ant-table-thead th { white-space: nowrap; background: var(--focus-subtle) !important; }
+.dc-core-dashboard .ant-table-tbody td:not(:first-child):not(:nth-child(2)) { text-align: right; }
+.dc-core-dashboard .ant-table-tbody td { white-space: nowrap; }
+.dc-core-dashboard .ant-card { border-radius: 8px; border-color: var(--focus-border); }
+.dc-core-dashboard .ant-space { flex-wrap: wrap; max-width: 100%; }
+.dc-core-dashboard .ant-picker, .dc-core-dashboard .ant-select { max-width: 100%; }
+#dc-hero-risk-root { padding: 16px !important; background: var(--focus-page) !important; }
+#dc-hero-risk-root .dc-hr-head { margin: 0; padding: 24px; background: var(--focus-surface); border-radius: 8px 8px 0 0; }
+#dc-hero-risk-root .dc-hr-sub, #dc-hero-risk-root .hint, #dc-hero-risk-root .dc-pro-section-title small { color: var(--focus-secondary); }
+#dc-hero-risk-root .dc-pro-filter { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px; padding: 16px; border-radius: 0 0 8px 8px; }
+#dc-hero-risk-root .dc-pro-filter > label { flex: 1 1 160px; min-width: 0; }
+#dc-hero-risk-root .dc-pro-filter > .dc-period-field { flex: 1 1 280px; min-width: 0; }
+#dc-hero-risk-root .dc-pro-filter .dc-period-picker { width: 100%; min-width: 0; }
+#dc-hero-risk-root .dc-pro-filter-state { flex: 1 1 200px; }
+#dc-hero-risk-root .dc-pro-filter > button { flex: 0 0 auto; width: auto; min-width: 80px; white-space: nowrap; height: 36px; padding: 0 16px; }
+#dc-hero-risk-root .dc-pro-filter > label select { width: 100%; }
+#dc-hero-risk-root .dc-pro-filter .dc-date-range-trigger { max-width: 100%; }
+#dc-hero-risk-root .dc-pro-notice { margin-inline: 0; }
+#dc-hero-risk-root .dc-risk-feed { overflow-x: auto; }
+#dc-hero-risk-root .dc-risk-feed-columns, #dc-hero-risk-root .dc-risk-feed-window { min-width: 720px; }
+#dc-hero-risk-root .dc-pro-section { margin-top: 16px; }
+#dc-hero-risk-root .dc-hr-card { border-radius: 8px; border-color: var(--focus-border); }
+#dc-hero-risk-root .dc-hr-metric .value { font-size: 30px; font-weight: 600; font-variant-numeric: tabular-nums; }
+#dc-hero-risk-root .dc-pro-table-wrap, #dc-hero-risk-root .dc-inline-detail-scroll { max-width: 100%; overflow: auto; }
+#dc-hero-risk-root .dc-pro-table th, #dc-hero-risk-root .dc-detail-table th { white-space: nowrap; background: var(--focus-subtle); }
+#dc-hero-risk-root .num { text-align: right; font-variant-numeric: tabular-nums; }
+#dc-hero-risk-root .dc-pro-empty { min-height: 240px; color: var(--focus-secondary); border-color: var(--focus-border); border-radius: 8px; }
+@media (max-width: 1100px) {
+  .dc-core-dashboard .dc-core-metrics > .ant-col { flex: 0 0 50%; max-width: 50%; }
+  #dc-hero-risk-root .dc-risk-overview-layout, #dc-hero-risk-root .dc-analysis-pair { grid-template-columns: minmax(0, 1fr); }
+}
+@media (max-width: 640px) {
+  .ant-layout:has(.dc-core-dashboard), .ant-layout:has(#dc-hero-risk-root) { min-width: 0; }
+  .ant-layout:has(> .ant-layout-content .dc-core-dashboard), .ant-layout:has(> .ant-layout-content #dc-hero-risk-root) { flex-direction: column; }
+  .ant-layout:has(.dc-core-dashboard) > .ant-layout-sider, .ant-layout:has(#dc-hero-risk-root) > .ant-layout-sider { width: 100% !important; max-width: 100% !important; min-width: 0 !important; flex: none !important; }
+  .ant-layout-sider:has(~ main .dc-core-dashboard) .ant-menu, .ant-layout-sider:has(~ main #dc-hero-risk-root) .ant-menu { display: flex; overflow-x: auto; }
+  .ant-layout-sider:has(~ main .dc-core-dashboard) .ant-menu-item, .ant-layout-sider:has(~ main #dc-hero-risk-root) .ant-menu-item { width: auto; flex: 0 0 auto; white-space: nowrap; }
+  .ant-layout-content:has(.dc-core-dashboard), .ant-layout-content:has(#dc-hero-risk-root) { padding: 8px !important; min-width: 0; width: 100% !important; }
+  .ant-layout:has(.dc-core-dashboard) > .ant-layout-header, .ant-layout:has(#dc-hero-risk-root) > .ant-layout-header { padding: 0 8px !important; }
+  .ant-layout-header:has(~ .ant-layout .dc-core-dashboard) > div, .ant-layout-header:has(~ .ant-layout #dc-hero-risk-root) > div { min-width: 0; }
+  .ant-layout-header:has(~ .ant-layout .dc-core-dashboard) > div:first-child, .ant-layout-header:has(~ .ant-layout #dc-hero-risk-root) > div:first-child { flex: 1; }
+  .ant-layout-header:has(~ .ant-layout .dc-core-dashboard) > div:first-child > div, .ant-layout-header:has(~ .ant-layout #dc-hero-risk-root) > div:first-child > div { flex-shrink: 0; white-space: nowrap; margin-right: 8px; }
+  body:has(.dc-core-dashboard) #dc-lc-chat-entry, body:has(#dc-hero-risk-root) #dc-lc-chat-entry { top: auto !important; bottom: 16px; right: 16px !important; }
+  body:has(.dc-core-dashboard) #dc-data-scope-switch, body:has(#dc-hero-risk-root) #dc-data-scope-switch { top: 104px !important; right: 16px !important; }
+  .ant-layout-header:has(~ .ant-layout .dc-core-dashboard) .ant-menu, .ant-layout-header:has(~ .ant-layout #dc-hero-risk-root) .ant-menu { min-width: 0 !important; width: 0 !important; flex: 1; }
+  .ant-layout-header:has(~ .ant-layout .dc-core-dashboard) > div:first-child > span, .ant-layout-header:has(~ .ant-layout #dc-hero-risk-root) > div:first-child > span { white-space: nowrap; flex-shrink: 0; }
+  .ant-layout-header:has(~ .ant-layout .dc-core-dashboard) > .ant-space, .ant-layout-header:has(~ .ant-layout #dc-hero-risk-root) > .ant-space { padding-left: 0 !important; flex-shrink: 0; }
+  .dc-core-dashboard .dc-core-metrics > .ant-col { flex: 0 0 100%; max-width: 100%; }
+  body:has(.dc-core-dashboard) header.ant-layout-header > div.flex.items-center.gap-1:first-child > ul.ant-menu, body:has(#dc-hero-risk-root) header.ant-layout-header > div.flex.items-center.gap-1:first-child > ul.ant-menu { min-width: 0 !important; width: 0 !important; flex: 1 1 auto !important; }
+  .dc-core-toolbar { align-items: flex-start; padding-top: 40px; }
+  .dc-core-toolbar > .ant-space-item:first-child { flex: 1 1 100%; }
+  .dc-core-toolbar > .ant-space-item:first-child .ant-space { flex-wrap: wrap; }
+  .dc-core-toolbar .text-xl { white-space: nowrap; }
+  .dc-core-section-toolbar { align-items: flex-start; flex-direction: column; }
+  .dc-core-section-toolbar > .ant-space { justify-content: flex-start; width: 100%; }
+  .dc-core-dashboard .ant-space-item { min-width: 0; max-width: 100%; }
+  .dc-core-dashboard .ant-card-extra { max-width: 100%; }
+  #dc-hero-risk-root { padding: 48px 8px 8px !important; }
+  #dc-hero-risk-root .dc-hr-head { padding: 16px; }
+  #dc-hero-risk-root .dc-pro-filter { gap: 8px; }
+  #dc-hero-risk-root .dc-pro-filter > label, #dc-hero-risk-root .dc-pro-filter > .dc-period-field { flex-basis: 100%; }
+  #dc-hero-risk-root .dc-pro-section-title { flex-wrap: wrap; gap: 8px; }
+  #dc-hero-risk-root .dc-risk-overview-metrics { grid-template-columns: minmax(0, 1fr); }
+  #dc-hero-risk-root .dc-hr-grid > * { min-width: 0; }
+  #dc-hero-risk-root .dc-risk-queue-body { grid-template-columns: minmax(0, 1fr); }
